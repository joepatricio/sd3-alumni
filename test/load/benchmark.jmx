<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SD3 Alumni Load &amp; Full Endpoint Test Suite" enabled="true">
      <stringProp name="TestPlan.comments">Port of test/load/node_benchmark.js extended to cover all API endpoints with verified credential signing and token checks.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,https)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,najealp.top)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CONFIG_PATH" elementType="Argument">
            <stringProp name="Argument.name">CONFIG_PATH</stringProp>
            <stringProp name="Argument.value">${__P(configPath,test/load/config.json)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FIXTURE_PATH" elementType="Argument">
            <stringProp name="Argument.name">FIXTURE_PATH</stringProp>
            <stringProp name="Argument.value">${__P(fixturePath,test/load/fixture.png)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DEFAULT_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">DEFAULT_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(defaultPassword,123456)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="COVERAGE_THREADS" elementType="Argument">
            <stringProp name="Argument.name">COVERAGE_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(coverageThreads,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIER1_THREADS" elementType="Argument">
            <stringProp name="Argument.name">TIER1_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(tier1Threads,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIER2_THREADS" elementType="Argument">
            <stringProp name="Argument.name">TIER2_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(tier2Threads,25)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIER3_THREADS" elementType="Argument">
            <stringProp name="Argument.name">TIER3_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(tier3Threads,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIER4_THREADS" elementType="Argument">
            <stringProp name="Argument.name">TIER4_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(tier4Threads,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIER5_THREADS" elementType="Argument">
            <stringProp name="Argument.name">TIER5_THREADS</stringProp>
            <stringProp name="Argument.value">${__P(tier5Threads,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIER_DURATION" elementType="Argument">
            <stringProp name="Argument.name">TIER_DURATION</stringProp>
            <stringProp name="Argument.value">${__P(tierDuration,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TIER_RAMPUP" elementType="Argument">
            <stringProp name="Argument.name">TIER_RAMPUP</stringProp>
            <stringProp name="Argument.value">${__P(tierRampUp,2)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="INCLUDE_EXTERNAL_APIS" elementType="Argument">
            <stringProp name="Argument.name">INCLUDE_EXTERNAL_APIS</stringProp>
            <stringProp name="Argument.value">${__P(includeExternalApis,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="INCLUDE_WRITES_IN_LOAD" elementType="Argument">
            <stringProp name="Argument.name">INCLUDE_WRITES_IN_LOAD</stringProp>
            <stringProp name="Argument.value">${__P(includeWritesInLoad,false)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RUN_COVERAGE" elementType="Argument">
            <stringProp name="Argument.name">RUN_COVERAGE</stringProp>
            <stringProp name="Argument.value">${__P(runCoverage,true)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LOAD_THINK_MIN_MS" elementType="Argument">
            <stringProp name="Argument.name">LOAD_THINK_MIN_MS</stringProp>
            <stringProp name="Argument.value">${__P(loadThinkMinMs,100)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LOAD_THINK_RANGE_MS" elementType="Argument">
            <stringProp name="Argument.name">LOAD_THINK_RANGE_MS</stringProp>
            <stringProp name="Argument.value">${__P(loadThinkRangeMs,400)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.path"></stringProp>
        <stringProp name="HTTPSampler.concurrentPool">6</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">25000</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Global HTTP Headers" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json, text/plain, */*</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">User-Agent</stringProp>
            <stringProp name="Header.value">LoadTest-JMeterEngine/5.6.3</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <!-- ================================================================== -->
      <!-- 1. SETUP THREAD GROUP: Preflight, Credential Signing & Token Tests -->
      <!-- ================================================================== -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp Thread Group (Auth &amp; Token Verification)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptestnow</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </SetupThreadGroup>
      <hashTree>
        
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[Setup] Sign Credentials, Verify All Tokens &amp; Discover Seed IDs" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.net.URI
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse
import java.time.Duration
import java.util.concurrent.CompletableFuture
import java.util.concurrent.Executors
import java.util.function.Supplier
import org.apache.jmeter.services.FileServer

def proto = vars.get(&quot;PROTOCOL&quot;) ?: &quot;https&quot;
def host = vars.get(&quot;HOST&quot;) ?: &quot;najealp.top&quot;
def port = (vars.get(&quot;PORT&quot;) ?: &quot;&quot;).trim()
def baseUrl = port ? &quot;${proto}://${host}:${port}&quot; : &quot;${proto}://${host}&quot;
props.put(&quot;baseUrl&quot;, baseUrl)

def defaultPassword = vars.get(&quot;DEFAULT_PASSWORD&quot;) ?: &quot;123456&quot;

// Locate config.json
def baseDir = FileServer.getFileServer().getBaseDir()
def configCandidates = [
    vars.get(&quot;CONFIG_PATH&quot;),
    new File(baseDir, &quot;config.json&quot;).getPath(),
    &quot;test/load/config.json&quot;,
    &quot;config.json&quot;
]
def configFile = configCandidates.find { it &amp;&amp; new File(it).exists() }?.with { new File(it) }
def config = null
if (configFile) {
    config = new JsonSlurper().parse(configFile)
    log.info(&quot;[Setup] Loaded config from: &quot; + configFile.getAbsolutePath())
} else {
    log.warn(&quot;[Setup] config.json not found; using built-in credential pools with default password.&quot;)
}

// Locate fixture.png for multipart upload test
def fixtureCandidates = [
    vars.get(&quot;FIXTURE_PATH&quot;),
    new File(baseDir, &quot;fixture.png&quot;).getPath(),
    &quot;test/load/fixture.png&quot;,
    &quot;fixture.png&quot;
]
def fixtureFile = fixtureCandidates.find { it &amp;&amp; new File(it).exists() }?.with { new File(it) }
if (fixtureFile) {
    props.put(&quot;resolvedFixturePath&quot;, fixtureFile.getAbsolutePath())
    log.info(&quot;[Setup] Found upload fixture: &quot; + fixtureFile.getAbsolutePath())
} else {
    props.put(&quot;resolvedFixturePath&quot;, &quot;&quot;)
    log.warn(&quot;[Setup] fixture.png not found; /api/upload will be skipped.&quot;)
}

def client = HttpClient.newBuilder()
    .connectTimeout(Duration.ofSeconds(15))
    .build()

def setupPool = Executors.newFixedThreadPool(10)
def runParallel = { List items, Closure fn -&gt;
    def futures = items.collect { item -&gt;
        CompletableFuture.supplyAsync({ fn.call(item) } as Supplier, setupPool)
    }
    return futures.collect { it.get() }
}

try {

def httpCall = { String method, String path, Object bodyObj = null, String bearer = null -&gt;
    def builder = HttpRequest.newBuilder()
        .uri(URI.create(baseUrl + path))
        .timeout(Duration.ofSeconds(25))
        .header(&quot;Accept&quot;, &quot;application/json&quot;)
        .header(&quot;User-Agent&quot;, &quot;LoadTest-JMeterSetup/5.6.3&quot;)
    if (bearer) {
        builder.header(&quot;Authorization&quot;, &quot;Bearer &quot; + bearer)
    }
    if (bodyObj != null) {
        builder.header(&quot;Content-Type&quot;, &quot;application/json&quot;)
        def jsonStr = (bodyObj instanceof String) ? (String) bodyObj : JsonOutput.toJson(bodyObj)
        builder.method(method, HttpRequest.BodyPublishers.ofString(jsonStr))
    } else {
        builder.method(method, HttpRequest.BodyPublishers.noBody())
    }
    def resp = client.send(builder.build(), HttpResponse.BodyHandlers.ofString())
    def raw = resp.body() ?: &quot;&quot;
    def parsed = null
    if (raw.trim().startsWith(&quot;{&quot;) || raw.trim().startsWith(&quot;[&quot;)) {
        try { parsed = new JsonSlurper().parseText(raw) } catch (Exception ignored) {}
    }
    return [status: resp.statusCode(), body: raw, json: parsed]
}

// 1. Preflight Check
def pre1 = httpCall(&quot;GET&quot;, &quot;/api/server-time&quot;)
def pre2 = httpCall(&quot;GET&quot;, &quot;/api/userStatuses&quot;)
if (pre1.status != 200 || pre2.status != 200) {
    def msg = &quot;FATAL: Preflight failed against ${baseUrl} (server-time=${pre1.status}, userStatuses=${pre2.status})&quot;
    log.error(msg)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;503&quot;)
    SampleResult.setResponseMessage(msg)
    SampleResult.setStopTestNow(true)
    return
}

// 2. Lookup Reference IDs
def fetchList = { String path -&gt;
    def r = httpCall(&quot;GET&quot;, path)
    if (r.status == 200) {
        if (r.json instanceof List) return r.json
        if (r.json instanceof Map &amp;&amp; r.json.data instanceof List) return r.json.data
    }
    return []
}

def refTables = [&quot;degrees&quot;, &quot;userStatuses&quot;, &quot;profileStatuses&quot;, &quot;contentStatuses&quot;, &quot;eventStatuses&quot;, &quot;eventCategories&quot;, &quot;bulletinCategories&quot;, &quot;connectionStatuses&quot;, &quot;donationStatuses&quot;, &quot;achievements&quot;]
def refResults = runParallel(refTables) { tbl -&gt; [tbl, fetchList(&quot;/api/&quot; + tbl)] }.collectEntries { [(it[0]): it[1]] }
def degrees = refResults.degrees
def userStatuses = refResults.userStatuses
def profileStatuses = refResults.profileStatuses
def contentStatuses = refResults.contentStatuses
def eventStatuses = refResults.eventStatuses
def eventCategories = refResults.eventCategories
def bulletinCategories = refResults.bulletinCategories
def connectionStatuses = refResults.connectionStatuses
def donationStatuses = refResults.donationStatuses
def achievements = refResults.achievements

def findId = { List list, String field, String val -&gt;
    def found = list.find { it[field]?.toString()?.equalsIgnoreCase(val) }
    return found ? found.id?.toString() : (list.isEmpty() ? &quot;&quot; : list[0].id?.toString())
}

def degreeId = findId(degrees, &quot;degreeAbbr&quot;, &quot;BSCpE&quot;)
def userStatusRegularId = findId(userStatuses, &quot;statusName&quot;, &quot;Regular&quot;)
def userStatusOfficialId = findId(userStatuses, &quot;statusName&quot;, &quot;Official&quot;)
def userStatusPendingId = findId(userStatuses, &quot;statusName&quot;, &quot;Pending&quot;)
def profileStatusPublicId = findId(profileStatuses, &quot;statusName&quot;, &quot;Public&quot;)
def profileStatusConnId = findId(profileStatuses, &quot;statusName&quot;, &quot;Connections Only&quot;)
def contentStatusPendingId = findId(contentStatuses, &quot;statusName&quot;, &quot;Pending&quot;)
def contentStatusApprovedId = findId(contentStatuses, &quot;statusName&quot;, &quot;Approved&quot;)
def eventStatusPendingId = findId(eventStatuses, &quot;statusName&quot;, &quot;Pending&quot;)
def eventStatusApprovedId = findId(eventStatuses, &quot;statusName&quot;, &quot;Approved&quot;)
def donationStatusPendingId = findId(donationStatuses, &quot;statusName&quot;, &quot;Pending&quot;)
def bulletinCategoryId = findId(bulletinCategories, &quot;bulletinCategoryName&quot;, &quot;Announcements&quot;)
def eventCategoryId = findId(eventCategories, &quot;eventCategoryName&quot;, &quot;Networking&quot;)
def achievementId = achievements.isEmpty() ? &quot;&quot; : achievements[0].id?.toString()

props.put(&quot;degreeId&quot;, degreeId)
props.put(&quot;userStatusRegularId&quot;, userStatusRegularId)
props.put(&quot;userStatusOfficialId&quot;, userStatusOfficialId)
props.put(&quot;userStatusPendingId&quot;, userStatusPendingId)
props.put(&quot;profileStatusPublicId&quot;, profileStatusPublicId)
props.put(&quot;profileStatusConnId&quot;, profileStatusConnId)
props.put(&quot;contentStatusPendingId&quot;, contentStatusPendingId)
props.put(&quot;contentStatusApprovedId&quot;, contentStatusApprovedId)
props.put(&quot;eventStatusPendingId&quot;, eventStatusPendingId)
props.put(&quot;eventStatusApprovedId&quot;, eventStatusApprovedId)
props.put(&quot;donationStatusPendingId&quot;, donationStatusPendingId)
props.put(&quot;bulletinCategoryId&quot;, bulletinCategoryId)
props.put(&quot;eventCategoryId&quot;, eventCategoryId)
props.put(&quot;achievementId&quot;, achievementId)

// 3. Authenticate Admins &amp; Test ALL Tokens Before Proceeding
def adminCandidates = []
def seenAdmins = [] as Set
def addAdminCand = { u, p -&gt;
    if (u &amp;&amp; !seenAdmins.contains(u)) {
        seenAdmins.add(u)
        adminCandidates &lt;&lt; [username: u, password: p ?: defaultPassword]
    }
}
def customAdmUser = props.get(&quot;adminUsername&quot;)
def customAdmPass = props.get(&quot;adminPassword&quot;) ?: defaultPassword
if (customAdmUser) {
    addAdminCand(customAdmUser, customAdmPass)
}
if (config?.credentials?.admins) {
    config.credentials.admins.each { addAdminCand(it.username, it.password ?: defaultPassword) }
}
// Always append built-in admin fallback pool in case config.json has failed/stale entries
(1..10).each { addAdminCand(&quot;admin&quot; + it, defaultPassword) }

def verifiedAdmins = []
def authReport = new StringBuilder()
authReport.append(&quot;Target: &quot;).append(baseUrl).append(&quot;\n&quot;)

def adminCheckResults = runParallel(adminCandidates) { adm -&gt;
    def loginRes = httpCall(&quot;POST&quot;, &quot;/api/auth/admin/login&quot;, [username: adm.username, password: adm.password])
    if (loginRes.status != 200 &amp;&amp; adm.password != defaultPassword) {
        loginRes = httpCall(&quot;POST&quot;, &quot;/api/auth/admin/login&quot;, [username: adm.username, password: defaultPassword])
    }
    if (loginRes.status != 200 || !loginRes.json?.token) {
        return [ok: false, msg: &quot;[-] Admin login failed for ${adm.username} (HTTP ${loginRes.status}); trying next account.&quot;]
    }
    def tok = loginRes.json.token.toString()
    // Test token on both /api/auth/admin/me and /api/admin/dashboard-stats BEFORE accepting
    def meRes = httpCall(&quot;GET&quot;, &quot;/api/auth/admin/me&quot;, null, tok)
    def dashRes = httpCall(&quot;GET&quot;, &quot;/api/admin/dashboard-stats&quot;, null, tok)
    if (meRes.status == 200 &amp;&amp; dashRes.status == 200 &amp;&amp; meRes.json?.admin?.id) {
        return [ok: true, entry: [username: adm.username, id: meRes.json.admin.id, token: tok], msg: &quot;[+] Admin verified: ${adm.username} (me=200, stats=200)&quot;]
    }
    return [ok: false, msg: &quot;[-] Admin token verification failed for ${adm.username} (me=${meRes.status}, stats=${dashRes.status}); trying next account.&quot;]
}
for (r in adminCheckResults) {
    if (r.ok) {
        verifiedAdmins &lt;&lt; r.entry
        authReport.append(r.msg).append(&quot;\n&quot;)
    } else {
        log.warn(r.msg)
        authReport.append(r.msg).append(&quot;\n&quot;)
    }
}

if (verifiedAdmins.isEmpty()) {
    def msg = &quot;FATAL: 0 admin accounts passed token verification. Refusing to run with 401 Unauthorized.\n&quot; + authReport.toString()
    log.error(msg)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;401&quot;)
    SampleResult.setResponseData(msg, &quot;UTF-8&quot;)
    SampleResult.setResponseMessage(&quot;Admin authentication &amp; token verification failed for all accounts&quot;)
    SampleResult.setStopTestNow(true)
    return
}

def primaryAdminToken = verifiedAdmins[0].token

// Helper to sign in &amp; verify user token, provisioning with defaultPassword (123456) if missing
def verifyUserAccount = { String email, String pass -&gt;
    def lr = httpCall(&quot;POST&quot;, &quot;/api/auth/login&quot;, [email: email, password: pass])
    if (lr.status != 200 &amp;&amp; pass != defaultPassword) {
        lr = httpCall(&quot;POST&quot;, &quot;/api/auth/login&quot;, [email: email, password: defaultPassword])
    }
    if (lr.status != 200 || !lr.json?.token) {
        return [ok: false, reason: &quot;login HTTP ${lr.status}&quot;]
    }
    def tok = lr.json.token.toString()
    def mr = httpCall(&quot;GET&quot;, &quot;/api/auth/me&quot;, null, tok)
    if (mr.status == 200 &amp;&amp; mr.json?.id) {
        return [ok: true, email: email, userId: mr.json.id.toString(), token: tok]
    }
    return [ok: false, reason: &quot;/api/auth/me HTTP ${mr.status}&quot;]
}

def signOrProvisionUser = { String email, String pass, String fullName, String statusId -&gt;
    def check = verifyUserAccount(email, pass)
    if (check.ok) return check
    log.info(&quot;[Setup] Provisioning dedicated JMX credential ${email} with default password via /api/admin/users...&quot;)
    def cr = httpCall(&quot;POST&quot;, &quot;/api/admin/users&quot;, [
        fullName: fullName,
        email: email,
        password: pass,
        degreeId: degreeId,
        batch: 2024,
        gender: &quot;Male&quot;,
        userStatusId: statusId,
        reason: &quot;JMX load suite dedicated credential&quot;
    ], primaryAdminToken)
    if (cr.status == 201 || cr.status == 200) {
        return verifyUserAccount(email, pass)
    }
    // Fallback 1: public registration
    def rr = httpCall(&quot;POST&quot;, &quot;/api/auth/register&quot;, [
        fullName: fullName,
        email: email,
        password: pass,
        degreeProgram: &quot;BSCpE&quot;,
        batch: 2024,
        gender: &quot;Male&quot;
    ])
    if (rr.status == 201 || rr.status == 200) {
        return verifyUserAccount(email, pass)
    }
    // Fallback 2: account exists with stale password; reset to defaultPassword and verify token
    def rpr = httpCall(&quot;POST&quot;, &quot;/api/auth/reset-password&quot;, [email: email, password: pass])
    if (rpr.status == 200) {
        return verifyUserAccount(email, pass)
    }
    return [ok: false, reason: &quot;provision failed (${cr.status}/${rr.status}/${rpr.status})&quot;]
}

// 4. Authenticate &amp; Test Official User Tokens
def officialCandidates = []
def seenOfficials = [] as Set
def addOfficialCand = { e, p -&gt;
    if (e &amp;&amp; !seenOfficials.contains(e)) {
        seenOfficials.add(e)
        officialCandidates &lt;&lt; [email: e, password: p ?: defaultPassword]
    }
}
if (config?.credentials?.officials) {
    config.credentials.officials.each { addOfficialCand(it.email, it.password ?: defaultPassword) }
}
(1..5).each { addOfficialCand(&quot;test.official&quot; + it + &quot;@najealp.top&quot;, defaultPassword) }

def verifiedOfficials = []
def officialCheckResults = runParallel(officialCandidates) { off -&gt;
    def res = verifyUserAccount(off.email, off.password)
    res.candEmail = off.email
    return res
}
for (res in officialCheckResults) {
    if (res.ok) {
        verifiedOfficials &lt;&lt; res
        authReport.append(&quot;[+] Official verified: &quot;).append(res.candEmail).append(&quot; (me=200)\n&quot;)
    } else {
        def errMsg = &quot;[-] Official account failed for ${res.candEmail} (${res.reason}); trying next account.&quot;
        log.warn(errMsg)
        authReport.append(errMsg).append(&quot;\n&quot;)
    }
}
if (verifiedOfficials.isEmpty()) {
    def provOff = signOrProvisionUser(&quot;loadtest_jmx_official@najealp.top&quot;, defaultPassword, &quot;JMX Official Tester&quot;, userStatusOfficialId)
    if (provOff.ok) {
        verifiedOfficials &lt;&lt; provOff
        authReport.append(&quot;[+] Provisioned &amp; verified Official: &quot;).append(provOff.email).append(&quot;\n&quot;)
    }
}

// 5. Sign Own Dedicated JMX Credentials + Test Regular Pool Tokens
def verifiedRegulars = []
def ownPair = runParallel([
    [email: &quot;loadtest_jmx_primary@najealp.top&quot;, name: &quot;JMX Primary Tester&quot;, label: &quot;Primary&quot;],
    [email: &quot;loadtest_jmx_secondary@najealp.top&quot;, name: &quot;JMX Secondary Tester&quot;, label: &quot;Secondary&quot;]
]) { spec -&gt;
    def r = signOrProvisionUser(spec.email, defaultPassword, spec.name, userStatusRegularId)
    r.label = spec.label
    return r
}
for (own in ownPair) {
    if (own.ok) {
        verifiedRegulars &lt;&lt; own
        authReport.append(&quot;[+] Signed &amp; verified own JMX &quot;).append(own.label).append(&quot;: &quot;).append(own.email).append(&quot; (me=200)\n&quot;)
    } else {
        authReport.append(&quot;[-] Own JMX &quot;).append(own.label).append(&quot; failed: &quot;).append(own.reason).append(&quot;\n&quot;)
    }
}

def regularCandidates = []
def seenRegulars = [] as Set
def addRegularCand = { e, p -&gt;
    if (e &amp;&amp; !seenRegulars.contains(e)) {
        seenRegulars.add(e)
        regularCandidates &lt;&lt; [email: e, password: p ?: defaultPassword]
    }
}
if (config?.credentials?.regulars) {
    config.credentials.regulars.each { addRegularCand(it.email, it.password ?: defaultPassword) }
}
(1..5).each { addRegularCand(&quot;test.regular&quot; + it + &quot;@najealp.top&quot;, defaultPassword) }

def regCheckResults = runParallel(regularCandidates) { reg -&gt;
    def res = verifyUserAccount(reg.email, reg.password)
    res.candEmail = reg.email
    return res
}
for (res in regCheckResults) {
    if (res.ok) {
        verifiedRegulars &lt;&lt; res
        authReport.append(&quot;[+] Regular verified: &quot;).append(res.candEmail).append(&quot; (me=200)\n&quot;)
    } else {
        def errMsg = &quot;[-] Regular account failed for ${res.candEmail} (${res.reason}); trying next account.&quot;
        log.warn(errMsg)
        authReport.append(errMsg).append(&quot;\n&quot;)
    }
}

if (verifiedOfficials.isEmpty() || verifiedRegulars.size() &lt; 2) {
    def msg = &quot;FATAL: Insufficient verified user tokens (officials=${verifiedOfficials.size()}, regulars=${verifiedRegulars.size()}).\n&quot; + authReport.toString()
    log.error(msg)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&quot;401&quot;)
    SampleResult.setResponseData(msg, &quot;UTF-8&quot;)
    SampleResult.setResponseMessage(&quot;User token verification failed&quot;)
    SampleResult.setStopTestNow(true)
    return
}

// Store Verified Token Pools in JMeter props
props.put(&quot;adminToken&quot;, verifiedAdmins[0].token)
props.put(&quot;adminUsername&quot;, verifiedAdmins[0].username)
props.put(&quot;adminTokenCount&quot;, String.valueOf(verifiedAdmins.size()))
verifiedAdmins.eachWithIndex { a, idx -&gt; props.put(&quot;adminToken_&quot; + idx, a.token) }

props.put(&quot;officialToken&quot;, verifiedOfficials[0].token)
props.put(&quot;officialUserId&quot;, verifiedOfficials[0].userId)
props.put(&quot;officialEmail&quot;, verifiedOfficials[0].email)
props.put(&quot;officialTokenCount&quot;, String.valueOf(verifiedOfficials.size()))
verifiedOfficials.eachWithIndex { o, idx -&gt;
    props.put(&quot;officialToken_&quot; + idx, o.token)
    props.put(&quot;officialUserId_&quot; + idx, o.userId)
}

props.put(&quot;regularToken&quot;, verifiedRegulars[0].token)
props.put(&quot;regularUserId&quot;, verifiedRegulars[0].userId)
props.put(&quot;regularEmail&quot;, verifiedRegulars[0].email)
props.put(&quot;secondaryToken&quot;, verifiedRegulars[1].token)
props.put(&quot;secondaryUserId&quot;, verifiedRegulars[1].userId)
props.put(&quot;secondaryEmail&quot;, verifiedRegulars[1].email)
props.put(&quot;regularTokenCount&quot;, String.valueOf(verifiedRegulars.size()))
verifiedRegulars.eachWithIndex { u, idx -&gt;
    props.put(&quot;regularToken_&quot; + idx, u.token)
    props.put(&quot;regularUserId_&quot; + idx, u.userId)
}

// 6. Discover Sample IDs Across All 27 Tables for GET /:table/:id Coverage
def discoverFirstId = { String table, String pk = &quot;id&quot; -&gt;
    def rows = fetchList(&quot;/api/&quot; + table + &quot;?_per_page=1&amp;_page=1&quot;)
    if (rows &amp;&amp; !rows.isEmpty()) {
        return rows[0][pk]?.toString() ?: &quot;&quot;
    }
    return &quot;&quot;
}

props.put(&quot;sampleDegreeId&quot;, degreeId)
props.put(&quot;sampleConnectionStatusId&quot;, connectionStatuses.isEmpty() ? &quot;&quot; : connectionStatuses[0].id?.toString())
props.put(&quot;sampleContentStatusId&quot;, contentStatusPendingId)
props.put(&quot;sampleUserStatusId&quot;, userStatusRegularId)
props.put(&quot;sampleDonationStatusId&quot;, donationStatusPendingId)
props.put(&quot;sampleEventStatusId&quot;, eventStatusPendingId)
props.put(&quot;sampleEventCategoryId&quot;, eventCategoryId)
props.put(&quot;sampleBulletinCategoryId&quot;, bulletinCategoryId)
props.put(&quot;sampleProfileStatusId&quot;, profileStatusPublicId)
props.put(&quot;sampleAchievementId&quot;, achievementId)

props.put(&quot;sampleUserId&quot;, verifiedRegulars[0].userId)
props.put(&quot;sampleProfileId&quot;, verifiedRegulars[0].userId)
props.put(&quot;sampleUserAuthId&quot;, verifiedRegulars[0].userId)
props.put(&quot;sampleUserStatisticId&quot;, verifiedRegulars[0].userId)

def runCovFlag = !((props.get(&quot;runCoverage&quot;) ?: &quot;true&quot;).equalsIgnoreCase(&quot;false&quot;))
def sampleTables = runCovFlag
    ? [&quot;bulletins&quot;, &quot;events&quot;, &quot;comments&quot;, &quot;donations&quot;, &quot;locations&quot;, &quot;records&quot;, &quot;userConnections&quot;, &quot;userAchievements&quot;, &quot;userRsvps&quot;, &quot;bulletinLikes&quot;, &quot;commentLikes&quot;, &quot;notifications&quot;, &quot;clefLogs&quot;]
    : [&quot;bulletins&quot;, &quot;events&quot;]
def discoveredSamples = runParallel(sampleTables) { tbl -&gt;
    def rows = fetchList(&quot;/api/&quot; + tbl + &quot;?_per_page=1&amp;_page=1&quot;)
    def idVal = (rows &amp;&amp; !rows.isEmpty()) ? (rows[0].id?.toString() ?: &quot;&quot;) : &quot;&quot;
    def extra = (tbl == &quot;notifications&quot; &amp;&amp; rows &amp;&amp; !rows.isEmpty()) ? (rows[0].notificationTypeId?.toString() ?: &quot;&quot;) : &quot;&quot;
    return [tbl: tbl, id: idVal, extra: extra]
}.collectEntries { [(it.tbl): it] }

props.put(&quot;sampleBulletinId&quot;, discoveredSamples.bulletins?.id ?: &quot;&quot;)
props.put(&quot;sampleEventId&quot;, discoveredSamples.events?.id ?: &quot;&quot;)
props.put(&quot;sampleCommentId&quot;, discoveredSamples.comments?.id ?: &quot;&quot;)
props.put(&quot;sampleDonationId&quot;, discoveredSamples.donations?.id ?: &quot;&quot;)
props.put(&quot;sampleLocationId&quot;, discoveredSamples.locations?.id ?: &quot;&quot;)
props.put(&quot;sampleRecordId&quot;, discoveredSamples.records?.id ?: &quot;&quot;)
props.put(&quot;sampleUserConnectionId&quot;, discoveredSamples.userConnections?.id ?: &quot;&quot;)
props.put(&quot;sampleUserAchievementId&quot;, discoveredSamples.userAchievements?.id ?: &quot;&quot;)
props.put(&quot;sampleUserRsvpId&quot;, discoveredSamples.userRsvps?.id ?: &quot;&quot;)
props.put(&quot;sampleBulletinLikeId&quot;, discoveredSamples.bulletinLikes?.id ?: &quot;&quot;)
props.put(&quot;sampleCommentLikeId&quot;, discoveredSamples.commentLikes?.id ?: &quot;&quot;)
props.put(&quot;sampleNotificationId&quot;, discoveredSamples.notifications?.id ?: &quot;&quot;)
props.put(&quot;sampleClefLogId&quot;, discoveredSamples.clefLogs?.id ?: &quot;&quot;)
props.put(&quot;notificationTypeId&quot;, discoveredSamples.notifications?.extra ?: &quot;&quot;)

def heroRes = httpCall(&quot;GET&quot;, &quot;/api/hero/images&quot;)
def heroImgUrl = (heroRes.status == 200 &amp;&amp; heroRes.json?.images &amp;&amp; !heroRes.json.images.isEmpty()) ? heroRes.json.images[0].url?.toString() : &quot;&quot;
props.put(&quot;sampleHeroImageUrl&quot;, heroImgUrl ?: &quot;&quot;)

authReport.append(&quot;[+] Verified Tokens Summary -&gt; Admins: &quot;).append(verifiedAdmins.size())
    .append(&quot;, Officials: &quot;).append(verifiedOfficials.size())
    .append(&quot;, Regulars: &quot;).append(verifiedRegulars.size()).append(&quot;\n&quot;)

log.info(authReport.toString())
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseData(authReport.toString(), &quot;UTF-8&quot;)
SampleResult.setResponseMessage(&quot;All credential pools signed and verified&quot;)

} finally {
    setupPool.shutdownNow()
}
</stringProp>
