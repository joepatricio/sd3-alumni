      <TestFragmentController guiclass="TestFragmentControllerGui" testclass="TestFragmentController" testname="Load Mix Test Fragment" enabled="true"/>
      <hashTree>
        <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="User Think Time (Uniform Random)" enabled="true">
          <stringProp name="ConstantTimer.delay">${LOAD_THINK_MIN_MS}</stringProp>
          <stringProp name="RandomTimer.range">${LOAD_THINK_RANGE_MS}</stringProp>
        </UniformRandomTimer>
        <hashTree/>
        
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Select Verified Tokens For Thread" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
int adminCount = Integer.parseInt(props.get(&quot;adminTokenCount&quot;) ?: &quot;0&quot;)
int offCount = Integer.parseInt(props.get(&quot;officialTokenCount&quot;) ?: &quot;0&quot;)
int regCount = Integer.parseInt(props.get(&quot;regularTokenCount&quot;) ?: &quot;0&quot;)
int tid = ctx.getThreadNum()
if (adminCount &gt; 0) {
    vars.put(&quot;curAdminToken&quot;, props.get(&quot;adminToken_&quot; + (tid % adminCount)))
}
if (offCount &gt; 0) {
    int idx = tid % offCount
    vars.put(&quot;curOfficialToken&quot;, props.get(&quot;officialToken_&quot; + idx))
    vars.put(&quot;curOfficialUserId&quot;, props.get(&quot;officialUserId_&quot; + idx))
}
if (regCount &gt; 0) {
    int idx = tid % regCount
    vars.put(&quot;curRegularToken&quot;, props.get(&quot;regularToken_&quot; + idx))
    vars.put(&quot;curRegularUserId&quot;, props.get(&quot;regularUserId_&quot; + idx))
}
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        
        <CacheManager guiclass="CacheManagerGui" testclass="CacheManager" testname="HTTP Cache Manager" enabled="true">
          <boolProp name="clearEachIteration">false</boolProp>
          <boolProp name="useExpires">true</boolProp>
          <boolProp name="CacheManager.controlledByThread">false</boolProp>
        </CacheManager>
        <hashTree/>

